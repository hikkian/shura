+    // checkpoints are appended to the slot save file, after the llama state payload
+    // they cannot be recreated from the final state alone (a recurrent state cannot be rewound)
+    static constexpr uint32_t SLOT_CKPT_MAGIC   = 0x504b4353; // "SCKP"
+    static constexpr uint32_t SLOT_CKPT_VERSION = 2;
+    static constexpr uint64_t SLOT_CKPT_HASH_INIT = 14695981039346656037ull;
+    static constexpr uint64_t SLOT_CKPT_BLOB_MAX = 512ull << 20;
+
+    static void ckpt_hash(uint64_t & hash, const void * data, size_t size) {
+        const auto * bytes = static_cast<const uint8_t *>(data);
+        for (size_t i = 0; i < size; ++i) {
+            hash = (hash ^ bytes[i]) * 1099511628211ull;
+        }
+    }
+
+    static bool ckpt_read(std::ifstream & ifs, void * dst, size_t size, size_t & n_read, uint64_t & hash) {
+        if (!ifs.read((char *) dst, size)) {
+            return false;
+        }
+        n_read += size;
+        ckpt_hash(hash, dst, size);
+        return true;
+    }
+
+    static bool ckpt_read_buf(std::ifstream & ifs, std::vector<uint8_t> & buf, size_t & n_read,
+                              size_t available, uint64_t & hash) {
+        uint64_t n = 0;
+        if (!ckpt_read(ifs, &n, sizeof(n), n_read, hash) || n > SLOT_CKPT_BLOB_MAX ||
+            n > available - std::min(available, n_read)) {
+            return false;
+        }
+        buf.resize(n);
+        return n == 0 || ckpt_read(ifs, buf.data(), n, n_read, hash);
+    }
+
+    static void ckpt_write(std::ofstream & ofs, const void * src, size_t size, size_t & n_written, uint64_t & hash) {
+        ofs.write((const char *) src, size);
+        n_written += size;
+        ckpt_hash(hash, src, size);
+    }
+
+    static void ckpt_write_buf(std::ofstream & ofs, const std::vector<uint8_t> & buf,
+                               size_t & n_written, uint64_t & hash) {
+        const uint64_t n = buf.size();
+        ckpt_write(ofs, &n, sizeof(n), n_written, hash);
+        if (n > 0) {
+            ckpt_write(ofs, buf.data(), n, n_written, hash);
+        }
+    }
+
+    size_t save_slot_checkpoints(const std::string & filepath, const server_slot & slot) const {
+        const size_t limit = std::max(0, std::min(params_base.n_ctx_checkpoints, params_base.n_slot_save_checkpoints));
+        if (slot.prompt.checkpoints.empty() || limit == 0) {
+            return 0;
+        }
+        std::ofstream ofs(filepath, std::ios::binary | std::ios::app);
+        if (!ofs) {
+            SRV_WRN("failed to append context checkpoints to '%s'\n", filepath.c_str());
+            return SIZE_MAX;
+        }
+        size_t n_written = 0;
+        const uint32_t magic   = SLOT_CKPT_MAGIC;
+        const uint32_t version = SLOT_CKPT_VERSION;
+        const uint32_t count   = (uint32_t) std::min(limit, slot.prompt.checkpoints.size());
+        uint64_t hash = SLOT_CKPT_HASH_INIT;
+        ckpt_write(ofs, &magic,   sizeof(magic),   n_written, hash);
+        ckpt_write(ofs, &version, sizeof(version), n_written, hash);
+        ckpt_write(ofs, &count,   sizeof(count),   n_written, hash);
+        auto it = slot.prompt.checkpoints.end();
+        for (uint32_t i = 0; i < count; ++i) {
+            --it;
+        }
+        for (; it != slot.prompt.checkpoints.end(); ++it) {
+            const auto & cur = *it;
+            ckpt_write(ofs, &cur.n_tokens, sizeof(cur.n_tokens), n_written, hash);
+            ckpt_write(ofs, &cur.pos_min,  sizeof(cur.pos_min),  n_written, hash);
+            ckpt_write(ofs, &cur.pos_max,  sizeof(cur.pos_max),  n_written, hash);
+            ckpt_write_buf(ofs, cur.data_tgt,  n_written, hash);
+            ckpt_write_buf(ofs, cur.data_dft,  n_written, hash);
+            ckpt_write_buf(ofs, cur.data_spec, n_written, hash);
+        }
+        ofs.write(reinterpret_cast<const char *>(&hash), sizeof(hash));
+        n_written += sizeof(hash);
+        ofs.flush();
+        if (!ofs) {
+            SRV_WRN("failed to append context checkpoints to '%s' - the appendix is incomplete\n", filepath.c_str());
+            return SIZE_MAX;
+        }
+        SRV_INF("appended %u context checkpoint(s) (%.3f MiB) to '%s'\n",
+                count, (float) n_written / 1024 / 1024, filepath.c_str());
+        return n_written;
+    }
+
+    // returns the number of bytes consumed, 0 if there is no usable appendix
+    size_t load_slot_checkpoints(const std::string & filepath, size_t offset, server_slot & slot) const {
+        std::ifstream ifs(filepath, std::ios::binary);
+        if (!ifs || !ifs.seekg(0, std::ios::end)) {
+            SRV_WRN("cannot read context checkpoint appendix in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        const std::streamoff end = ifs.tellg();
+        if (end < 0 || uint64_t(end) < offset || !ifs.seekg(offset)) {
+            SRV_WRN("invalid context checkpoint offset in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        const size_t available = size_t(uint64_t(end) - offset);
+        if (available == 0) {
+            SRV_WRN("no context checkpoint appendix in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        size_t n_read = 0;
+        uint64_t hash = SLOT_CKPT_HASH_INIT;
+        uint32_t magic   = 0;
+        uint32_t version = 0;
+        uint32_t count   = 0;
+        if (!ckpt_read(ifs, &magic, sizeof(magic), n_read, hash) || magic != SLOT_CKPT_MAGIC) {
+            SRV_WRN("unknown context checkpoint appendix in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        if (!ckpt_read(ifs, &version, sizeof(version), n_read, hash) || version != SLOT_CKPT_VERSION ||
+            !ckpt_read(ifs, &count, sizeof(count), n_read, hash) || count > 1024 ||
+            count > (uint32_t) std::max(0, params_base.n_slot_save_checkpoints)) {
+            SRV_WRN("invalid context checkpoint version/count in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        std::list<common_prompt_checkpoint> checkpoints;
+        for (uint32_t i = 0; i < count; ++i) {
+            common_prompt_checkpoint cur;
+            cur.id_task = -1;
+            if (!ckpt_read(ifs, &cur.n_tokens, sizeof(cur.n_tokens), n_read, hash) ||
+                !ckpt_read(ifs, &cur.pos_min,  sizeof(cur.pos_min),  n_read, hash) ||
+                !ckpt_read(ifs, &cur.pos_max,  sizeof(cur.pos_max),  n_read, hash) ||
+                !ckpt_read_buf(ifs, cur.data_tgt,  n_read, available, hash) ||
+                !ckpt_read_buf(ifs, cur.data_dft,  n_read, available, hash) ||
+                !ckpt_read_buf(ifs, cur.data_spec, n_read, available, hash)) {
+                SRV_WRN("truncated or oversized context checkpoint appendix in '%s' - using legacy restore\n", filepath.c_str());
+                return 0;
+            }
+            if (cur.n_tokens < 0 || cur.n_tokens > slot.prompt.n_tokens() ||
+                cur.pos_min < 0 || cur.pos_max < cur.pos_min) {
+                SRV_WRN("invalid context checkpoint position in '%s' - using legacy restore\n", filepath.c_str());
+                return 0;
+            }
+            checkpoints.push_back(std::move(cur));
+        }
+        uint64_t stored_hash = 0;
+        if (available - std::min(available, n_read) != sizeof(stored_hash) ||
+            !ifs.read(reinterpret_cast<char *>(&stored_hash), sizeof(stored_hash)) || stored_hash != hash) {
+            SRV_WRN("corrupt context checkpoint appendix in '%s' - using legacy restore\n", filepath.c_str());
+            return 0;
+        }
+        n_read += sizeof(stored_hash);
+        slot.prompt.checkpoints = std::move(checkpoints);
+        SRV_INF("restored %zu context checkpoint(s) from '%s'\n", slot.prompt.checkpoints.size(), filepath.c_str());
+        return n_read;
+    }
