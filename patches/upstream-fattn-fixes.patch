# upstream-fattn-fixes: исправления гонок в ядрах внимания из upstream llama.cpp (MIT License, llama.cpp authors).
# Источник: upstream PR #30573 «CUDA/HIP: fix shared-memory WAR hazard in flash_attn_ext_vec» (второй __syncwarp после цикла K-тайла; 
# на HIP первый __syncwarp раньше был выключен #ifndef GGML_USE_HIP — теперь безусловный, это __syncwarp HIP = фенс+wave barrier)
# и PR #30572 (граница цикла fattn-tile: <= вместо <). Перенос по смыслу на нашу ветку после gqavec2/fattn2 (REBASE1c).
# Порядок в build-llama.sh: после fattn2-upstream-28102. Отчёт: reports/REPORT-REBASE1c.md.
diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index 8981ab8..8a0a211 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -955,7 +955,7 @@ static __global__ void flash_attn_tile(
     if (ncols2 == 1) {
         // Branch with out-of-bounds checks.
         int k_VKQ_0 = blockIdx.y*nbatch_fa;
-        while (k_VKQ_0 < k_VKQ_max - nbatch_fa) {
+        while (k_VKQ_0 <= k_VKQ_max - nbatch_fa) {
             constexpr bool oob_check = false;
             flash_attn_tile_iter<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K, use_logit_softcap, oob_check>
                 (Q_tmp, K_h2, V_h2, maskh, ne01, logit_softcap, slope, KQ, KV_tmp,
diff --git a/ggml/src/ggml-cuda/fattn-vec.cuh b/ggml/src/ggml-cuda/fattn-vec.cuh
index eb2ec7c..8025088 100644
--- a/ggml/src/ggml-cuda/fattn-vec.cuh
+++ b/ggml/src/ggml-cuda/fattn-vec.cuh
@@ -393,9 +393,7 @@ static __global__ void flash_attn_ext_vec(
 #endif // V_DOT2_F32_F16_AVAILABLE
         }
 
-#ifndef GGML_USE_HIP
-        __syncwarp();
-#endif // GGML_USE_HIP
+        __syncwarp(); // KQ values written by all lanes must be visible before the V loop reads them (also on HIP)
 
 #pragma unroll (ncols2 > 1 ? GQA_UNRV : 64)
         for (int k0 = 0; k0 < WARP_SIZE; k0 += V_cols_per_iter) {
@@ -465,6 +463,8 @@ static __global__ void flash_attn_ext_vec(
             }
 #endif // V_DOT2_F32_F16_AVAILABLE
         }
+
+        __syncwarp(); // KQ/VKQ of this tile are done; the next tile writes KQ (write-after-read hazard, #30573)
     }
 
     if (sinks && blockIdx.y == 0) {
