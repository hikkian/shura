     return res;
 }
 
+// On ROCm an executable graph never gives back the kernel-argument slots it took, and every
+// hipGraphExecUpdate takes new ones (ROCm/rocm-systems#10713), so an exec that is updated after
+// each re-capture grows until it is destroyed. Destroying and re-instantiating frees the slots.
+// GGML_HIP_GRAPH_EXEC_UPDATE=1 restores the update path on HIP; GGML_CUDA_GRAPH_REINSTANTIATE=1
+// selects re-instantiation on CUDA.
+static bool ggml_cuda_graph_reinstantiate_on_update() {
+#if defined(GGML_USE_HIP)
+    static const bool keep_update = getenv("GGML_HIP_GRAPH_EXEC_UPDATE") != nullptr;
+    return !keep_update;
+#else
+    static const bool reinstantiate = getenv("GGML_CUDA_GRAPH_REINSTANTIATE") != nullptr;
+    return reinstantiate;
+#endif // defined(GGML_USE_HIP)
+}
+
+// GGML_CUDA_GRAPH_STATS=<seconds> prints the graph cache counters at most once per interval (default 60 s).
+static void ggml_cuda_graph_stats_log(ggml_backend_cuda_context * cuda_ctx) {
+    static const int64_t interval_us = [] {
+        const char * env = getenv("GGML_CUDA_GRAPH_STATS");
+        if (env == nullptr) {
+            return (int64_t) 0;
+        }
+        const int secs = atoi(env);
+        return (int64_t) (secs > 0 ? secs : 60) * 1000000;
+    }();
+    if (interval_us == 0) {
+        return;
+    }
+    static std::atomic<int64_t> next_log{0};
+    const int64_t now = ggml_time_us();
+    int64_t expected = next_log.load(std::memory_order_relaxed);
+    if (now < expected || !next_log.compare_exchange_strong(expected, now + interval_us)) {
+        return;
+    }
+    const ggml_cuda_graph_stats & s = ggml_cuda_graph_stats_get();
+    GGML_LOG_INFO("cuda graph stats: live=%zu captures=%llu instantiates=%llu exec_updates=%llu launches=%llu direct=%llu destroyed=%llu reinstantiate_on_update=%d\n",
+        cuda_ctx->cuda_graphs.size(),
+        (unsigned long long) s.captures.load(), (unsigned long long) s.instantiates.load(),
+        (unsigned long long) s.exec_updates.load(), (unsigned long long) s.launches.load(),
+        (unsigned long long) s.direct_runs.load(), (unsigned long long) s.destroyed.load(),
+        ggml_cuda_graph_reinstantiate_on_update() ? 1 : 0);
+}
+
 static void ggml_cuda_graph_update_executable(ggml_backend_cuda_context * cuda_ctx, uint64_t graph_key) {
     ggml_cuda_graph * graph = cuda_ctx->cuda_graph(graph_key);
 
+    if (ggml_cuda_graph_reinstantiate_on_update()) {
+        CUDA_CHECK(cudaGraphExecDestroy(graph->instance));
+        graph->instance = nullptr;
+        CUDA_CHECK(cudaGraphInstantiate(&graph->instance, graph->graph, NULL, NULL, 0));
+        ggml_cuda_graph_stats_get().instantiates++;
+        return;
+    }
+
 #if CUDART_VERSION >= 12000
     cudaGraphExecUpdateResultInfo result_info;
     cudaError_t stat = cudaGraphExecUpdate(graph->instance, graph->graph, &result_info);
@@ -2743,8 +2794,10 @@ static void ggml_cuda_graph_update_executable(ggml_backend_cuda_context * cuda_c
         CUDA_CHECK(cudaGraphExecDestroy(graph->instance));
         graph->instance = nullptr;
         CUDA_CHECK(cudaGraphInstantiate(&graph->instance, graph->graph, NULL, NULL, 0));
+        ggml_cuda_graph_stats_get().instantiates++;
     } else {
         GGML_ASSERT(stat == cudaSuccess);
+        ggml_cuda_graph_stats_get().exec_updates++;
     }
 }
 #endif // USE_CUDA_GRAPH
