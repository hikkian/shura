+// Lifecycle counters of the graph cache, printed by ggml_cuda_graph_stats_log() when GGML_CUDA_GRAPH_STATS is set.
+struct ggml_cuda_graph_stats {
+    std::atomic<uint64_t> captures{0};      // stream captures (one new cudaGraph_t each)
+    std::atomic<uint64_t> instantiates{0};  // cudaGraphInstantiate calls
+    std::atomic<uint64_t> exec_updates{0};  // cudaGraphExecUpdate calls
+    std::atomic<uint64_t> launches{0};      // cudaGraphLaunch calls
+    std::atomic<uint64_t> direct_runs{0};   // graphs evaluated without a cuda graph
+    std::atomic<uint64_t> destroyed{0};     // ggml_cuda_graph objects destroyed (evicted or replaced)
+};
+
+inline ggml_cuda_graph_stats & ggml_cuda_graph_stats_get() {
+    static ggml_cuda_graph_stats stats;
+    return stats;
+}
