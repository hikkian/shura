# Источник: собственная правка проекта, reports/REPORT-FUSE3.md.
diff -ruN -x build -x '*.rej' -x '*.orig' orig/ggml/src/ggml-cuda/common.cuh src/ggml/src/ggml-cuda/common.cuh
--- a/ggml/src/ggml-cuda/common.cuh	2026-10-09 19:49:48.000000000 +0500
+++ b/ggml/src/ggml-cuda/common.cuh	2026-10-18 01:19:42.533188385 +0500
