#!/usr/bin/env python3
"""The gateway starts "the llama-server binary" with llama.cpp's flags: this launcher runs the fake instead. It is a script (not a
shell wrapper that execs python) so that the process the gateway started still has this file in its command line."""
import runpy
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
runpy.run_module("fake_llama_server", run_name="__main__")
