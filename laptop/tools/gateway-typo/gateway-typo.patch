+def llama_ask(request):
+    """Typo guard: one short non-streaming request to the loaded model (prompt prefix unchanged -> KV cache reused). Returns the content or None."""
+    conn = http.client.HTTPConnection(G["llamaHost"], G["llamaPort"], timeout=300)
+    try:
+        conn.request("POST", "/v1/chat/completions", body=json.dumps(request, ensure_ascii=False).encode(), headers={"Content-Type": "application/json"})
+        r = conn.getresponse()
+        if r.status != 200:
+            log(f"typo guard: request failed, HTTP {r.status}")
+            return None
+        msg = (json.loads(r.read()).get("choices") or [{}])[0].get("message") or {}
+        return (msg.get("content") or "").strip() or None
+    finally:
+        conn.close()
+
