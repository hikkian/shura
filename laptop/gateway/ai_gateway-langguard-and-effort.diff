+def apply_effort_budget(obj, model_id):
+    """Add reasoning_budget_tokens (+ message) for the request's reasoning_effort, unless the client set one."""
+    mc = M["models"].get(model_id) or {}
+    budgets = mc.get("effortBudgets") or {}
+    effort = obj.get("reasoning_effort")
+    if not budgets or not isinstance(effort, str) or effort not in budgets or "reasoning_budget_tokens" in obj:
+        return False
+    obj["reasoning_budget_tokens"] = int(budgets[effort])
+    obj.setdefault("reasoning_budget_message", mc.get("reasoningBudgetMessage", BUDGET_MESSAGE))
+    return True
+
+
+def local_title(req):
+    """Chat title from the last user message: first line, at most 50 characters, cut at a word boundary."""
+    text = ""
+    for msg in reversed(req.get("messages", [])):
+        if msg.get("role") != "user":
+            continue
+        c = msg.get("content")
+        text = c if isinstance(c, str) else " ".join(p.get("text", "") for p in c or [] if isinstance(p, dict))
+        if text.strip() and not text.startswith("Generate a title for this conversation"):
+            break
+    line = next((ln.strip() for ln in text.splitlines() if ln.strip()), "")
+    line = re.sub(r"\s+", " ", re.sub(r"[`*#>_]+", "", line)).strip(" .,:;-")
+    if len(line) > 50:
+        line = line[:50].rsplit(" ", 1)[0].rstrip(" .,:;-") + "…"
+    return line or "Новый чат"
+
