+def llama_rewrite(req, text, lang):
+    """Language guard: ask the loaded model (same prompt prefix, KV cache reused) to rewrite its final answer."""
+    conn = http.client.HTTPConnection(G["llamaHost"], G["llamaPort"], timeout=900)
+    try:
+        body = json.dumps(lang_guard.rewrite_request(req, text, lang), ensure_ascii=False).encode()
+        conn.request("POST", "/v1/chat/completions", body=body, headers={"Content-Type": "application/json"})
+        r = conn.getresponse()
+        if r.status != 200:
+            log(f"language guard: rewrite failed, HTTP {r.status}")
+            return None
+        msg = (json.loads(r.read()).get("choices") or [{}])[0].get("message") or {}
+        return (msg.get("content") or "").strip() or None
+    finally:
+        conn.close()
