+GLOBAL_INSTR = (str(Path.home() / ".config/shuracode"), str(Path.home() / ".local/share/shuracode"))
+ENV_RE = re.compile(r"You are powered by the model named[^\n]*\n(?:[^\n]*\n)??<env>.*?</env>\n?", re.S)
+INSTR_RE = re.compile(r"Instructions from: (\S+)\n.*?(?=\nInstructions from: |\n<mcp_instructions>|\Z)", re.S)
