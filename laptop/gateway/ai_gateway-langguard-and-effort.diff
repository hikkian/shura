+def request_kind(obj):
+    """Prompt kind: hash of the tools and the system prompt (already free of per-project text, see hoist_project_context). Requests of one kind share
+    their long prefix (tools + system), so they can reuse each other's cached state."""
+    msgs = obj.get("messages") or []
+    sys0 = msgs[0].get("content") if msgs and msgs[0].get("role") == "system" else ""
+    sys0 = sys0 if isinstance(sys0, str) else json.dumps(sys0)
+    tools = json.dumps(obj.get("tools") or [], sort_keys=True, ensure_ascii=False)
+    if not sys0 and tools == "[]":
+        return ""
+    return hashlib.sha256((tools + "|" + sys0).encode()).hexdigest()[:10]
+
