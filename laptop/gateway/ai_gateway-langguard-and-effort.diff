+def hoist_project_context(req):
+    """Move the per-project part of an agent system prompt (<env>: folder, date; project AGENTS.md) into the first
+    user message. The system block (tools + prompt) is then identical in every project, and the server's context
+    checkpoint at the first user message lets a new chat reuse it instead of re-reading ~9k tokens (~16 s).
+    The model sees the same text, only in a different place. Returns True if changed."""
+    msgs = req.get("messages") or []
+    if len(msgs) < 2 or msgs[0].get("role") != "system" or not isinstance(msgs[0].get("content"), str):
+        return False
+    sysmsg = msgs[0]["content"]
+    if "<env>" not in sysmsg:
+        return False
+    moved = [m.group(0).strip() for m in ENV_RE.finditer(sysmsg)]
+    sysmsg = ENV_RE.sub("", sysmsg)
+    for m in list(INSTR_RE.finditer(sysmsg)):
+        if not m.group(1).startswith(GLOBAL_INSTR):
+            moved.append(m.group(0).strip())
+            sysmsg = sysmsg.replace(m.group(0), "", 1)
+    first = next((m for m in msgs[1:] if m.get("role") == "user"), None)
+    if not moved or first is None:
+        return False
+    block = "<context>\n" + "\n\n".join(moved) + "\n</context>\n\n"
+    c = first.get("content")
+    if isinstance(c, str):
+        first["content"] = block + c
+    elif isinstance(c, list):
+        first["content"] = [{"type": "text", "text": block.rstrip()}] + c
+    else:
+        return False
+    msgs[0]["content"] = sysmsg.rstrip() + "\n"
+    return True
+
