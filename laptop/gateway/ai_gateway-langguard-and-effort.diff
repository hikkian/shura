+# Thinking budget per ShuraCode effort level (reasoning_effort after the camelCase rename). llama-server (shura.cpp)
+# enforces it in the sampler: after N thinking tokens it forces `reasoning_budget_message` + "\n</think>" and the
+# answer/tool call starts (common/reasoning-budget.cpp). It is a sampling parameter, NOT part of the prompt, so the
+# cached prefix and the saved slots are unaffected. -1 = unlimited. Per model: "effortBudgets" in model-launch.json,
+# e.g. {"low": 2048, "medium": 8192, "high": 16384, "xhigh": 32768, "max": -1}; "none" (fast) has no thinking.
+BUDGET_MESSAGE = ("\n\nConsidering the limited time by the user, "
+                  "I have to give the solution based on the thinking directly now.")  # Qwen3 docs' early-stop text
