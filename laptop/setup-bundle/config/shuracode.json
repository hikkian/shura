{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "tiel-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Shura (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "tiel-coder": {
          "name": "Tiel-Coder 35B-A3B (local, 200K ctx)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "variants": {
            "fast": {
              "reasoningEffort": "low"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "options": {
            "reasoningEffort": "medium"
          }
        },
