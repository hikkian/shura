+// script class of one code point for --ban-scripts homoglyph: 1 = Cyrillic letter, 2 = Latin letter, 0 = anything else
+static int common_script_class(uint32_t cp) {
+    if ((cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z')) return 2;
+    if (cp >= 0x0400 && cp <= 0x04FF) return 1;   // Cyrillic incl. Kazakh letters
+    return 0;
+}
+
+// first and last code point classes of a token piece (0 if the piece starts/ends with a partial UTF-8 sequence)
+uint8_t common_piece_script_bits(const std::string & s) {
+    const unsigned char * p = (const unsigned char *) s.data();
+    const size_t n = s.size();
+    int first = -1, last = 0;
+    for (size_t i = 0; i < n; ) {
+        const unsigned char c = p[i];
+        size_t len = c < 0x80 ? 1 : c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : c >= 0xC0 ? 2 : 0;
+        int cls = 0;
+        if (len == 0 || i + len > n) { len = 1; cls = 0; }
+        else {
+            uint32_t cp = len == 1 ? c : len == 2 ? (((c & 0x1F) << 6) | (p[i+1] & 0x3F))
+                        : len == 3 ? (((c & 0x0F) << 12) | ((p[i+1] & 0x3F) << 6) | (p[i+2] & 0x3F))
+                        : (((c & 0x07) << 18) | ((p[i+1] & 0x3F) << 12) | ((p[i+2] & 0x3F) << 6) | (p[i+3] & 0x3F));
+            cls = common_script_class(cp);
+        }
+        if (first < 0) first = cls;
+        last = cls;
+        i += len;
+    }
+    return (uint8_t) ((first < 0 ? 0 : first) | (last << 2));
+}
+
+// true if the token text contains a CJK character (Han, kana, Hangul, Bopomofo, CJK/fullwidth punctuation),
+// or ends with a truncated UTF-8 sequence whose lead byte (0xE3..0xED) can only start U+3000..U+DFFF
+// (byte-level BPE splits rare characters across tokens). 0xE2 (dashes, quotes, arrows) is never banned.
+bool common_piece_has_cjk(const std::string & s) {
+    const unsigned char * p = (const unsigned char *) s.data();
+    const size_t n = s.size();
+    for (size_t i = 0; i < n; ) {
+        const unsigned char c = p[i];
+        if (c < 0x80 || c < 0xC0) { i++; continue; }          // ASCII or a stray continuation byte
+        const size_t len = c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : 2;
+        if (i + len > n) {
+            return len == 3 && c >= 0xE3 && c <= 0xED;
+        }
+        uint32_t cp;
+        if (len == 2)      cp = ((c & 0x1F) << 6)  |  (p[i+1] & 0x3F);
+        else if (len == 3) cp = ((c & 0x0F) << 12) | ((p[i+1] & 0x3F) << 6)  |  (p[i+2] & 0x3F);
+        else               cp = ((c & 0x07) << 18) | ((p[i+1] & 0x3F) << 12) | ((p[i+2] & 0x3F) << 6) | (p[i+3] & 0x3F);
+        if ((cp >= 0x1100  && cp <= 0x11FF)  ||   // Hangul Jamo
+            (cp >= 0x2E80  && cp <= 0x9FFF)  ||   // CJK radicals, punctuation, kana, Bopomofo, Hangul compat, Han
+            (cp >= 0xA960  && cp <= 0xA97F)  ||   // Hangul Jamo ext-A
+            (cp >= 0xAC00  && cp <= 0xD7FF)  ||   // Hangul syllables, Jamo ext-B
+            (cp >= 0xF900  && cp <= 0xFAFF)  ||   // CJK compatibility ideographs
+            (cp >= 0xFE30  && cp <= 0xFE4F)  ||   // CJK compatibility forms
+            (cp >= 0xFF00  && cp <= 0xFFEF)  ||   // halfwidth/fullwidth forms
+            (cp >= 0x20000 && cp <= 0x3FFFF)) {   // Han extensions B..
+            return true;
+        }
+        i += len;
+    }
+    return false;
+}
