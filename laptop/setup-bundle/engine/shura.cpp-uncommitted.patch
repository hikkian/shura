+// --ban-scripts homoglyph: forbid a switch between Latin and Cyrillic letters inside one word
+// (e.g. "держитcя" with a Latin c, or "Трigram"). A token that starts with a letter of the other script
+// is banned right after a token that ended with a letter; a space, hyphen, digit or punctuation resets it.
+struct homoglyph_guard {
+    std::shared_ptr<const std::vector<uint8_t>> cls;
+    int prev = 0;   // class of the last character generated: 0 none, 1 Cyrillic, 2 Latin
+};
+static const char * homoglyph_name(const llama_sampler *) { return "homoglyph-guard"; }
+static void homoglyph_accept(llama_sampler * s, llama_token t) {
+    auto * g = (homoglyph_guard *) s->ctx;
+    g->prev = (t >= 0 && (size_t) t < g->cls->size()) ? (((*g->cls)[t] >> 2) & 3) : 0;
+}
+static void homoglyph_apply(llama_sampler * s, llama_token_data_array * cur_p) {
+    auto * g = (homoglyph_guard *) s->ctx;
+    if (g->prev == 0) return;
+    const int forbidden = g->prev == 1 ? 2 : 1;
+    size_t keep = 0;
+    for (size_t i = 0; i < cur_p->size; i++) {
+        const llama_token t = cur_p->data[i].id;
+        const int first = (t >= 0 && (size_t) t < g->cls->size()) ? ((*g->cls)[t] & 3) : 0;
+        if (first != forbidden && cur_p->data[i].logit != -INFINITY) keep++;
+    }
+    if (keep == 0) return;   // never leave the sampler without a candidate
+    for (size_t i = 0; i < cur_p->size; i++) {
+        const llama_token t = cur_p->data[i].id;
+        const int first = (t >= 0 && (size_t) t < g->cls->size()) ? ((*g->cls)[t] & 3) : 0;
+        if (first == forbidden) cur_p->data[i].logit = -INFINITY;
+    }
+}
+static void homoglyph_reset(llama_sampler * s) { ((homoglyph_guard *) s->ctx)->prev = 0; }
+static llama_sampler * homoglyph_clone(const llama_sampler * s);
+static void homoglyph_free(llama_sampler * s) { delete (homoglyph_guard *) s->ctx; }
+static void homoglyph_copy_state(const llama_sampler * src, llama_sampler * dst) {
+    ((homoglyph_guard *) dst->ctx)->prev = ((const homoglyph_guard *) src->ctx)->prev;
+}
+static llama_sampler_i homoglyph_iface = {
+    /* .name              = */ homoglyph_name,
+    /* .accept            = */ homoglyph_accept,
+    /* .apply             = */ homoglyph_apply,
+    /* .reset             = */ homoglyph_reset,
+    /* .clone             = */ homoglyph_clone,
+    /* .free              = */ homoglyph_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ homoglyph_copy_state,
+};
+static llama_sampler * homoglyph_init(std::shared_ptr<const std::vector<uint8_t>> cls) {
+    return llama_sampler_init(&homoglyph_iface, new homoglyph_guard{ std::move(cls), 0 });
+}
+static llama_sampler * homoglyph_clone(const llama_sampler * s) {
+    const auto * g = (const homoglyph_guard *) s->ctx;
+    llama_sampler * c = homoglyph_init(g->cls);
+    ((homoglyph_guard *) c->ctx)->prev = g->prev;
+    return c;
+}
