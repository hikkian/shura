#!/usr/bin/env bash
# shura - everyday entry point.
#
#   shura            open ShuraCode in the current folder (model starts loading in the background)
#   shura launch     pick a project folder in a dialog, then open ShuraCode there in a terminal window
#   shura window     open a separate Shura window for the current folder
#   shura status     gateway / model state, RAM and VRAM headroom
#   shura monitor    open the compact Shura Monitor window
#   shura doctor     preflight checks for backend, memory, disk, gateway, service and model
#   shura warm       load the model now
#   shura unload     unload the model now (frees RAM/VRAM; long session is saved to disk); --force cuts an answer in progress
#   shura pause | resume  game-mode pause / request-based resume (requires opt-in)
#   shura off | on   disable / re-enable the AI entirely
#   shura logs       follow gateway + llama-server logs
#   shura restart    restart the gateway service
#   shura memory     the knowledge store: save | search | read | fix | forget [--purge] | restore | export | import | stats (no gateway, no model)
#   shura check      describe this machine and show what Shura would pick for it (installs nothing)
#   shura report     write an anonymous hardware report to paste into a GitHub issue
#   shura install    any OS/GPU/CPU: download, test and set up the best configuration (--dry-run shows the plan)
#   shura start|stop run / stop the server installed by `shura install` (the Linux+NVIDIA setup.sh uses the gateway)
#   shura uninstall  remove downloaded files; add --all for full Shura removal (asks first)
#
# Timeouts (seconds): SHURA_HTTP_TIMEOUT (off/on/unload, default 60), SHURA_PROBE_TIMEOUT (is the gateway there, default 10),
# SHURA_WARM_TIMEOUT (default 300), SHURA_START_WAIT (wait for a started gateway, default 20), SHURA_BUSY_WAIT (default 60).
#
# Works with any desktop and terminal. Terminal: $SHURA_TERMINAL, then $TERMINAL, then the first one
# found. Folder dialog: zenity, kdialog or yad (optional).
set -euo pipefail

GW="${SHURA_GATEWAY:-http://127.0.0.1:8080}"
APP_ID="io.github.hikkian.Shura"
export PATH="$HOME/.local/bin:$PATH"
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

notify() {
  if command -v notify-send >/dev/null; then notify-send -a Shura "Shura" "$1" || true; fi
  echo "$1"
}

fail() {  # a failed command must be visible: desktop notification (the launcher has no terminal) + stderr + exit 1
  if command -v notify-send >/dev/null; then notify-send -a Shura "Shura" "$1" || true; fi
  echo "$1" >&2
  exit 1
}

HTTP_TIMEOUT="${SHURA_HTTP_TIMEOUT:-60}"
# With an apiKey configured the gateway's switches ask for it: SHURA_API_KEY, else the key in model-launch.json.
API_KEY="${SHURA_API_KEY:-}"
if [ -z "$API_KEY" ]; then
  API_KEY="$(python3 - "${AI_GATEWAY_CONFIG:-$REPO_DIR/config}/model-launch.json" 2>/dev/null <<'PY' || true
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("apiKey") or "")
except Exception:
    pass
PY
)"
fi
PROBE_TIMEOUT="${SHURA_PROBE_TIMEOUT:-10}"
WARM_TIMEOUT="${SHURA_WARM_TIMEOUT:-300}"
START_WAIT="${SHURA_START_WAIT:-20}"
BUSY_WAIT="${SHURA_BUSY_WAIT:-60}"
OFF_WAIT="${SHURA_OFF_WAIT:-10}"      # how long `shura off` waits for the model to leave READY

probe_gateway() {  # 0 = answers; 1 = nobody listens (refused, unreachable); 2 = the connection was accepted but no answer in time
  local rc=0                  # (the gateway holds its lock while it saves a session: busy is not dead, and must not be restarted)
  curl -s --max-time "$1" -o /dev/null "$GW/guardian/status" || rc=$?
  case "$rc" in 0) return 0 ;; 28) return 2 ;; *) return 1 ;; esac
}

ensure_gateway() {
  local rc=0 waited=0 i
  probe_gateway "$PROBE_TIMEOUT" || rc=$?
  [ "$rc" = 0 ] && return 0
  if [ "$rc" = 2 ]; then
    while [ "$waited" -lt "$BUSY_WAIT" ]; do
      rc=0; probe_gateway "$PROBE_TIMEOUT" || rc=$?
      [ "$rc" = 0 ] && return 0
      [ "$rc" = 2 ] || break
      waited=$((waited + PROBE_TIMEOUT))
    done
    if [ "$rc" = 2 ]; then
      echo "Gateway is busy (no answer for ${waited}s, probably saving or loading a session) - continuing without restarting it" >&2
      return 0
    fi
  fi
  if ! systemctl --user cat ai-gateway.service >/dev/null 2>&1; then
    fail "Gateway is not running and there is no ai-gateway service. Plain 'shura' needs the gateway of the Linux+NVIDIA setup (setup.sh); a machine set up with 'shura install' uses: shura start, shura status"
  fi
  systemctl --user start ai-gateway.service
  for ((i = 0; i < START_WAIT * 2; i++)); do
    probe_gateway 1 && return 0
    sleep 0.5
  done
  fail "Gateway did not start - see: shura logs"
}

GW_ERR="" GW_BODY=""
gw_post() {  # POST $1 to the gateway; 0 only for an HTTP 2xx. Otherwise GW_ERR says what happened.
  local tmp code rc=0
  tmp="$(mktemp)"
  code="$(curl -s --max-time "${2:-$HTTP_TIMEOUT}" -o "$tmp" -w '%{http_code}' -X POST ${API_KEY:+-H "Authorization: Bearer $API_KEY"} "$GW$1")" || rc=$?
  GW_BODY="$(head -c 500 "$tmp")"; rm -f "$tmp"
  if [ "$rc" = 0 ] && [ "${code:0:1}" = 2 ]; then return 0; fi
  case "$rc" in
    0)  GW_ERR="the gateway at $GW answered HTTP $code${GW_BODY:+: $GW_BODY}" ;;
    7)  GW_ERR="the gateway is not running at $GW (start it with: shura restart)" ;;
    28) GW_ERR="no answer from the gateway within ${2:-$HTTP_TIMEOUT}s (busy saving a session?); it may still finish, check: shura status" ;;
    *)  GW_ERR="the request to $GW$1 failed (curl exit $rc)" ;;
  esac
  return 1
}

warm() {  # a 1-token request makes the gateway load the model (and restore the last long session); 0 only if it answered 2xx
  local tmp code rc=0
  tmp="$(mktemp)"
  code="$(curl -s --max-time "$WARM_TIMEOUT" -o "$tmp" -w '%{http_code}' "$GW/v1/chat/completions" -H 'Content-Type: application/json' \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
    -d '{"messages":[{"role":"user","content":"hi"}],"max_tokens":1}')" || rc=$?
  GW_BODY="$(head -c 500 "$tmp")"; rm -f "$tmp"
  if [ "$rc" = 0 ] && [ "${code:0:1}" = 2 ]; then return 0; fi
  case "$rc" in
    0)  GW_ERR="the gateway refused (HTTP $code)${GW_BODY:+: $GW_BODY}" ;;
    28) GW_ERR="the model was not ready within ${WARM_TIMEOUT}s; it may still be loading, check: shura status" ;;
    *)  GW_ERR="could not reach the gateway at $GW (curl exit $rc)" ;;
  esac
  return 1
}

model_state() {  # prints the model status word of the gateway, or nothing
  curl -s --max-time 5 "$GW/guardian/status" 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("status", ""))
except Exception: pass' 2>/dev/null || true
}

status() {
  local js
  local rc=0
  js="$(curl -s --max-time "$PROBE_TIMEOUT" "$GW/guardian/status")" || rc=$?
  if [ -z "$js" ]; then
    if [ "$rc" = 28 ]; then      # it accepted the connection: it is alive, busy (saving a session); restarting it would kill the model
      echo "gateway is busy (no answer within ${PROBE_TIMEOUT}s, probably saving or loading a session) - try again in a moment, do not restart it"
    else
      echo "gateway is not running - start it with: shura restart"
    fi
    return 1
  fi
  SHURA_STATUS="$js" python3 - <<'PY'
import json, os
d = json.loads(os.environ["SHURA_STATUS"])
state = d["status"] + (" (vision)" if d["vision"] else "")
err = f"  - {d['last_error']}" if d["last_error"] else ""
print(f"model      : {state}{err}")
print("ai         : " + ("disabled (shura on to enable)" if d["override"] == "OFF" else "enabled"))
print(f"ram free   : {d['ram_available_gb']} GB")
print(f"vram free  : {d['vram_free_gb']} GB")
if d.get("vram_guard_enabled"):
    print("vram guard : " + ("emergency, waiting for response end" if d.get("vram_emergency") else
                           "pressure, active session stays loaded" if d.get("vram_pressure") else "watching"))
    if d.get("guard_fallback"):
        print("fallback   : " + d["guard_fallback"])
    if d.get("last_event"):
        print("last event : " + d["last_event"]["reason"] + " - " + d["last_event"]["detail"])
    if not d.get("monitor_healthy", True) or d.get("monitor_thread_alive") is False:
        print("monitor    : unhealthy - " + d.get("monitor_error", "thread stopped"))
if d.get("game_mode", {}).get("enabled"):
    g = d["game_mode"]
    print(f"game mode  : {g['reason'] or 'quiet'} ({g['elapsed_seconds']} s), active={g['active']}")
    if g.get("errors"): print("game errors: " + "; ".join(g["errors"]))
p = d.get("polite_model", {})
if p.get("enabled"):
    print(f"polite CPU : {p.get('mode', 'dynamic')} L{p['level']}, weight={p.get('weight')}, available={p['available']}" + (" - " + p['error'] if p.get('error') else ""))
g = d.get("slot_gears", {})
if g.get("enabled"):
    for model, gear in g.get("models", {}).items():
        print(f"slot gears : {model} {gear['slots']} - {gear['reason']}")
v = d.get("vram_valve", {})
if v.get("enabled"):
    if v.get("models"):
        for model, valve in v["models"].items():
            print(f"vram valve : {model} {valve['slots']}/{valve['configured_max']} - {valve['reason']}")
    else:
        print("vram valve : enabled; waiting for model")
if d["status"] == "READY":
    print(f"idle       : {d['idle_seconds']} s (auto-unload after {d['idle_unload_after_seconds']} s)")
PY
}

run() {  # exec, or just print with SHURA_DRY_RUN=1 (used to test terminal handling without opening windows)
  if [ -n "${SHURA_DRY_RUN:-}" ]; then printf '%q ' "$@"; echo; exit 0; fi
  exec "$@"
}

pick_dir() {  # $1 = start folder; prints the chosen folder, or nothing if cancelled
  local title="Shura - choose a project folder"
  if command -v zenity >/dev/null; then zenity --file-selection --directory --title="$title" --filename="$1/" 2>/dev/null
  elif command -v kdialog >/dev/null; then kdialog --title "$title" --getexistingdirectory "$1" 2>/dev/null
  elif command -v yad >/dev/null; then yad --file --directory --title="$title" --filename="$1/" 2>/dev/null
  else echo "$1"; fi  # no dialog tool installed: reopen the last folder
}

open_terminal() {  # $1 = folder: open a new terminal window there running `shura`
  local dir="$1" title self term t
  title="Shura · $(basename "$dir")"
  self="$(readlink -f "$0")"
  term="${SHURA_TERMINAL:-${TERMINAL:-}}"
  if [ -z "$term" ]; then
    for t in ghostty kitty alacritty wezterm foot konsole gnome-terminal ptyxis xfce4-terminal tilix xdg-terminal-exec xterm; do
      if command -v "$t" >/dev/null; then term="$t"; break; fi
    done
  fi
  cd "$dir"
  # Where the terminal supports it, give the window Shura's app ID so it shows under the Shura icon.
  case "$(basename "${term%% *}")" in
    ghostty)           run ghostty --class="$APP_ID" --title="$title" --working-directory="$dir" -e "$self" ;;
    kitty)             run kitty --class "$APP_ID" --title "$title" --directory "$dir" "$self" ;;
    alacritty)         run alacritty --class "$APP_ID" --title "$title" --working-directory "$dir" -e "$self" ;;
    wezterm)           run wezterm start --class "$APP_ID" --cwd "$dir" -- "$self" ;;
    foot)              run foot --app-id="$APP_ID" --title="$title" --working-directory="$dir" "$self" ;;
    konsole)           run konsole --workdir "$dir" -p tabtitle="$title" -e "$self" ;;
    gnome-terminal)    run gnome-terminal --title="$title" --working-directory="$dir" -- "$self" ;;
    ptyxis)            run ptyxis --new-window --working-directory="$dir" -- "$self" ;;
    xfce4-terminal)    run xfce4-terminal --title="$title" --working-directory="$dir" -x "$self" ;;
    tilix)             run tilix --title="$title" --working-directory="$dir" -e "$self" ;;
    xdg-terminal-exec) run xdg-terminal-exec "$self" ;;
    xterm)             run xterm -class "$APP_ID" -T "$title" -e "$self" ;;
    "")                notify "No terminal emulator found - set SHURA_TERMINAL"; exit 1 ;;
    *)                 local -a cmd; read -ra cmd <<< "$term"; run "${cmd[@]}" -e "$self" ;;
  esac
}

launch() {
  local last="$HOME/.cache/shura/last-dir" dir
  mkdir -p "$(dirname "$last")"
  dir="$(pick_dir "$(cat "$last" 2>/dev/null || echo "$HOME")")"
  [ -n "$dir" ] || exit 0
  echo "$dir" > "$last"
  open_terminal "$dir"
}

case "${1:-}" in
  "")      ensure_gateway; (warm &) ; exec shuracode ;;
  launch)  launch ;;
  window)  open_terminal "$PWD" ;;
  status)  if [ -f "${SHURA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/shura}/state.json" ] && ! systemctl --user cat ai-gateway.service >/dev/null 2>&1; then
             exec python3 "$REPO_DIR/installer/universal/cli.py" status      # installed by `shura install`: no gateway
           else status; fi ;;
  monitor) exec python3 "$REPO_DIR/installer/universal/monitor_window.py" "${@:2}" ;;
  doctor) if [ "${2:-}" = "--hw-dump" ]; then exec python3 "$REPO_DIR/installer/universal/hw_dump.py" "${@:2}"; fi
          exec python3 "$REPO_DIR/installer/universal/cli.py" doctor "${@:2}" ;;
  warm)    ensure_gateway; s=$(date +%s); warm || fail "Model was not loaded: $GW_ERR"; notify "Model loaded in $(( $(date +%s) - s ))s" ;;
  unload)  path=/guardian/unload; [ "${2:-}" = "--force" ] && path="$path?force=1"
           gw_post "$path" || fail "Model was not unloaded: $GW_ERR"; notify "Model unloaded" ;;
  pause|resume) curl --fail-with-body -s --max-time "$HTTP_TIMEOUT" -X POST "$GW/guardian/$1"; echo ;;
  off)     gw_post /guardian/ai-off || fail "AI was NOT disabled: $GW_ERR"
           for ((i = 0; i < OFF_WAIT; i++)); do [ "$(model_state)" = READY ] || break; sleep 1; done
           if [ "$(model_state)" = READY ]; then
             echo "Warning: AI is disabled, but the model still reports READY (it is freed when the running request ends). Check: shura status" >&2
           fi
           notify "AI disabled (shura on to re-enable)" ;;
  on)      gw_post /guardian/ai-on || fail "AI was NOT enabled: $GW_ERR"; notify "AI enabled" ;;
  logs)    exec journalctl --user -u ai-gateway -f -o cat ;;
  restart) systemctl --user restart ai-gateway.service && notify "Gateway restarted" ;;
  memory)  exec python3 "$REPO_DIR/gateway/lifelong_store.py" "${@:2}" ;;
  check|report|install|uninstall|start|stop) exec python3 "$REPO_DIR/installer/universal/cli.py" "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *)       echo "unknown command: $1 (see: shura help)"; exit 2 ;;
esac
